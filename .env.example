# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Use the Supabase pooler connection string for local/serverless development.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public
# Use the direct database connection for Prisma migrations and introspection.
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?schema=public

# Media catalog providers
TMDB_API_KEY=your-tmdb-api-key
ANILIST_API_URL=https://graphql.anilist.co

# Protects POST /api/catalog/sync. Use a long, random value in deployed environments.
CATALOG_SYNC_SECRET=replace-with-a-long-random-secret
